{
  "name": "agentrouter-connector",
  "version": "2.0.0",
  "private": true,
  "description": "Secure AgentRouter connector exposing an OpenAI-compatible gateway and MCP tools, with concurrency control, retries, fallback, redaction and usage ledger.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/index.js",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.15.30",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  }
}
