# === AgentRouter upstream ===
# Source-proven legacy/OpenAI-compatible surface from the attached build record:
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_KEY=REPLACE_ME

# The attached build record found these compatibility headers necessary for that surface.
AGENTROUTER_COMPAT_HEADERS=true
AGENTROUTER_ORIGINATOR=codex_cli_rs
AGENTROUTER_VERSION=0.101.0
AGENTROUTER_USER_AGENT=codex_cli_rs/0.101.0 (Mac OS 26.0.1; arm64) Apple_Terminal/464

# === Connector server ===
PORT=3000
HOST=0.0.0.0
CONNECTOR_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE
MCP_AUTH_TOKEN=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_VALUE

# === Runtime ===
DEFAULT_MODEL=deepseek-v4-flash
MAX_CONCURRENCY=8
MAX_BATCH_TASKS=32
MAX_RETRIES=4
BACKOFF_BASE_MS=400
REQUEST_TIMEOUT_MS=120000
MAX_BODY_BYTES=4194304

# === Privacy / ledger ===
REDACT_PROMPTS=true
LEDGER_PATH=./data/ledger.jsonl
LOG_PROMPTS=false

# Optional MCP perimeter checks for public deployments.
# Comma-separated hostnames and exact Origins. Leave blank for non-browser MCP clients.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
